   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{\\sqrt{2} \\cdot 2^{- l} \\alpha^{- l} \\Gamma\\left(l + \\frac{1}{2}\\right)}{2 \\sqrt{\\alpha}}$"
      ],
      "text/plain": [
       "sqrt(2)*gamma(l + 1/2)/(2*2**l*sqrt(alpha)*alpha**l)"
      ]
     },
     "execution_count": 22,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import sympy as sp\n",
    "\n",
    "l = sp.symbols(\"l\", integer=True, nonnegative=True)\n",
    "alpha = sp.symbols(\"alpha\", positive=True)\n",
    "S0 = sp.sqrt((sp.pi/(2*alpha)))\n",
    "\n",
    "S = sp.Function(\"S\")\n",
    "\n",
    "rec = sp.Eq(S(l), (2*l - 1)/(4*alpha) * S(l-1))\n",
    "\n",
    "sol = sp.rsolve(rec, S(l), {S(0): S0})\n",
    "sol"
   ]
  },
